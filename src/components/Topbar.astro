---
import { formatDate } from "@/lib/utils";
import { ROUTES } from "@/lib/routes";

const { user } = Astro.locals;
const today = formatDate();
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <span class="text-blue-100/70">{today}</span>
        <div class="flex items-center gap-3">
          <a href={ROUTES.wedding} class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wesele
          </a>
          <form method="POST" action={ROUTES.signOut}>
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <span class="text-blue-100/70">{today}</span>
        <div class="flex gap-3">
          <a href={ROUTES.signIn} class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href={ROUTES.signUp} class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
