---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getOrCreateWedding } from "@/lib/services/wedding.service";
import { listTables } from "@/lib/services/table.service";
import { ROUTES } from "@/lib/routes";
import type { Table, Wedding } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let wedding: Wedding | null = null;
let tables: Table[] = [];
let loadError = false;

if (supabase && user) {
  const weddingResult = await getOrCreateWedding(supabase, user.id);
  if (weddingResult.ok) {
    wedding = weddingResult.data;
    const tablesResult = await listTables(supabase, wedding.id);
    if (tablesResult.ok) {
      tables = tablesResult.data;
    } else {
      loadError = true;
    }
  } else {
    loadError = true;
  }
}
---

<Layout title={wedding?.name ?? "Wesele"}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-2xl">
      <div class="flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {wedding?.name ?? "Wesele"}
        </h1>
        <form method="POST" action={ROUTES.signOut}>
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Wyloguj się
          </button>
        </form>
      </div>

      {
        loadError && (
          <p class="mt-6 rounded-lg border border-red-400/30 bg-red-500/10 p-4 text-sm text-red-200">
            Nie udało się wczytać wesela. Spróbuj odświeżyć stronę.
          </p>
        )
      }

      {
        !loadError && wedding && (
          <section class="mt-8">
            <h2 class="mb-3 text-lg font-semibold text-blue-100">Stoły</h2>
            {tables.length === 0 ? (
              <p class="text-sm text-blue-100/60">Nie dodano jeszcze żadnych stołów.</p>
            ) : (
              <ul class="space-y-2">
                {tables.map((table) => (
                  <li class="flex items-center justify-between rounded-lg border border-white/10 bg-white/5 px-4 py-3">
                    <span class="font-medium">{table.name}</span>
                    <span class="text-sm text-blue-100/60">
                      {table.seatCount} {table.seatCount === 1 ? "miejsce" : "miejsc"}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }
    </div>
  </div>
</Layout>
